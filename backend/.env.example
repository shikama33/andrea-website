# Copia este archivo como ".env" y rellena los valores. El .env NUNCA se sube a git.

# Sitios que pueden llamar a la API (separados por coma). En producción: el dominio real.
CORS_ORIGINS=http://localhost:5173

# --- Aviso por correo (opcional: si lo dejas vacío, el mensaje solo se guarda en la base de datos) ---
OWNER_EMAIL=correo-de-andrea@ejemplo.com
EMAIL_FROM_NAME=Andrea Briones Website

# Ejemplo con Gmail: activa la verificación en 2 pasos y crea una "contraseña de aplicación".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASSWORD=contraseña-de-aplicacion
